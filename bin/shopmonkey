#!/usr/bin/env php
<?php

    /*
     |--------------------------------------------------------------------------
     | Error reporting
     |--------------------------------------------------------------------------
     |
     | Third-party dependencies (symfony/console, termwind, illuminate/support,
     | laravel/prompts, ...) still trigger PHP 8.4 "implicitly nullable" notices
     | from inside their own code. Those are not actionable from this CLI, so we
     | hide E_DEPRECATED from the output by default. Set SHOPMONKEY_DEBUG=1 to
     | see everything again.
     |
     */
    error_reporting(getenv('SHOPMONKEY_DEBUG') ? E_ALL : E_ALL & ~E_DEPRECATED);

    $root = dirname(__DIR__);

    if (! is_file(sprintf('%s/vendor/autoload.php', $root))) {
        $root = dirname(__DIR__, 4);
    }

    require sprintf('%s/vendor/autoload.php', $root);

    use Shopmonkeynl\ShopmonkeyCli\Application;
    use Shopmonkeynl\ShopmonkeyCli\Commands\Pull;
    use Shopmonkeynl\ShopmonkeyCli\Commands\Watch;
    use Shopmonkeynl\ShopmonkeyCli\Commands\Auth;
    use Shopmonkeynl\ShopmonkeyCli\Commands\Init;
    use Shopmonkeynl\ShopmonkeyCli\Commands\Update;

    $application = new Application();

    $application->add(new Pull());
    $application->add(new Watch());
    $application->add(new Auth());
    $application->add(new Init());
    $application->add(new Update());
    $application->run();
